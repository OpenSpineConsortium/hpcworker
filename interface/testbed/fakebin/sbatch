#!/bin/bash
# fake sbatch (hpcworker's test bed): logs the call to $FAKE_SCHED_DIR/calls; refuses with the message in
# $FAKE_SCHED_DIR/sbatch_fail when that file is not empty; else prints the next id and lists the job PENDING
# (FAKE_REASON, default Priority). FAKE_SBATCH_DELAY: seconds to wait first. With --test-only and a file
# $FAKE_SCHED_DIR/testonly it answers as Slurm's estimate instead and lists nothing: each line is
# "PARTITION GRES_TYPE SECONDS [QOS]" (- for a job asking no GPU, * for one asking a generic gpu:N), and the call
# whose --partition, --gres type and, where the line names one, --qos match is told it starts SECONDS from now;
# "refuse" in place of SECONDS, or no line, refuses it.
# fake sbatch: logs, refuses when <sched>/sbatch_fail holds a message, else prints the next id and lists the job PENDING
d="${FAKE_SCHED_DIR:?}"
echo "sbatch $*" >> "$d/calls"
# (34) the folder of the job's checkpoint marker, as the job would find it in its environment
echo "${HPCW_CHECKPOINTS:-}" >> "$d/checkpoints_env"
sleep "${FAKE_SBATCH_DELAY:-0}"
if [ -s "$d/sbatch_fail" ]; then cat "$d/sbatch_fail" >&2; exit 1; fi
case " $* " in *" --test-only "*)
  if [ -f "$d/testonly" ]; then
    p="" t=- q=""
    for a in "$@"; do case "$a" in
      --partition=*) p=${a#--partition=};; --qos=*) q=${a#--qos=};;
      --gres=gpu:*) t=${a#--gres=gpu:}; case "$t" in [0-9]*) t='*';; *) t=${t%%:*};; esac;;
    esac; done
    s=$(awk -v p="$p" -v t="$t" -v q="$q" '$1 == p && $2 == t && ($4 == "" || $4 == q) { print $3; exit }' "$d/testonly")
    case "$s" in
      ""|refuse) echo "sbatch: error: Batch job submission failed: Requested node configuration is not available" >&2; exit 1;;
      *) echo "sbatch: Job 99 to start at $(date -d "@$(( $(date +%s) + s ))" +%Y-%m-%dT%H:%M:%S) using 4 processors on nodes n1 in partition $p" >&2; exit 0;;
    esac
  fi;;
esac
n=$(cat "$d/next_id" 2>/dev/null || echo 40501234); echo $((n + 1)) > "$d/next_id"
echo "$n|PENDING|${FAKE_REASON:-Priority}|N/A|" >> "$d/jobs"
echo "$n"
