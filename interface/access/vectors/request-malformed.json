{
 "vector": "request-malformed",
 "route": "/request",
 "summary": "An e-mail that is not <AccessID>@wayne.edu: 400 with a sentence the page shows",
 "request": {
  "method": "POST",
  "path": "/request",
  "headers": {
   "origin": "https://openspineconsortium.com",
   "content-type": "application/json"
  },
  "body": {
   "v": 2,
   "access_id": "cd5678",
   "name": "C. D.",
   "email": "cd5678@gmail.com",
   "google_account": "c.d.student@gmail.com",
   "purpose": "spine segmentation for my thesis",
   "product": "bridge"
  }
 },
 "answer": {
  "status": 400,
  "headers": {
   "access-control-allow-credentials": "true",
   "access-control-allow-headers": "authorization, content-type",
   "access-control-allow-methods": "GET, POST, OPTIONS",
   "access-control-allow-origin": "https://openspineconsortium.com",
   "access-control-max-age": "600",
   "cache-control": "no-store",
   "content-type": "application/json",
   "vary": "origin"
  },
  "body": {
   "error": "the e-mail must be cd5678@wayne.edu"
  }
 }
}
