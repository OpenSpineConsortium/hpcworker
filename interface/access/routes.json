{
 "format": 1,
 "title": "The access service's routes",
 "description": "Every route the Worker answers, at either address (base): who calls it, how it is authorised, and the schema of each request and answer, by status. type is the answer's content-type (a client compares up to the first ';' when the value has none). A schema is named as a file of this folder, or a definition in one (<file>#/$defs/<name>). An answer status not listed under a method is one of its auth's answers, or of '*' (every other method). A reader ignores a field it does not know. vectors/ holds the real Worker's answers, each naming its path here. ACCESS_CHECK.md and README.md (Routes) say the same in words.",
 "base": [
  "https://beethoven-access.openspineconsortium.workers.dev",
  "https://ashley-service.openspineconsortium.workers.dev"
 ],
 "auth": {
  "none": {
   "description": "no credential"
  },
  "admin-token": {
   "description": "authorization: Bearer <ADMIN_TOKEN>, the maintainer's token, read from a mode-0600 file and sent in a header, never on a command line (curl -H @file). A browser page must come from the website (SITE_ORIGIN); a program sends no Origin. CORS for the website, credentials allowed (a Cloudflare Access session in front of /admin/* rides along).",
   "answers": {
    "401": {
     "type": "application/json",
     "schema": "error.schema.json"
    },
    "403": {
     "type": "application/json",
     "schema": "error.schema.json"
    }
   }
  },
  "microsoft-sign-in": {
   "description": "authorization: Bearer <the person's Microsoft sign-in token>, which the service uses once, to ask Microsoft Graph who the person is; never stored or logged.",
   "answers": {
    "401": {
     "type": "application/json",
     "schema": "error.schema.json"
    },
    "403": {
     "type": "application/json",
     "schema": "error.schema.json"
    },
    "422": {
     "type": "application/json",
     "schema": "error.schema.json"
    },
    "429": {
     "type": "application/json",
     "schema": "error.schema.json"
    }
   }
  },
  "link": {
   "description": "a signed one-use link from an e-mail (?t=<token>): GET shows one question and one button, the button POSTs the answer"
  }
 },
 "routes": [
  {
   "path": "/health",
   "for": "programs",
   "callers": [
    "anyone"
   ],
   "auth": "none",
   "summary": "the service is up; deploy.yml reads it after each deploy",
   "methods": {
    "GET": {
     "answers": {
      "200": {
       "type": "application/json",
       "schema": "health.answer.schema.json"
      }
     }
    }
   }
  },
  {
   "path": "/access_check",
   "for": "programs",
   "callers": [
    "OpenSpineConsortium/beethoven-extension"
   ],
   "auth": "none",
   "origin": "any (CORS *)",
   "summary": "is this one account approved, on this installation? Yes or no, never the list. 120 checks per account and 2000 per connection a day",
   "methods": {
    "POST": {
     "request": {
      "type": [
       "text/plain",
       "application/json"
      ],
      "max_bytes": 8192,
      "schema": "access-check.request.schema.json"
     },
     "answers": {
      "200": {
       "type": "application/json",
       "schema": "access-check.answer.schema.json"
      },
      "400": {
       "type": "application/json",
       "schema": "error.schema.json"
      },
      "413": {
       "type": "application/json",
       "schema": "error.schema.json"
      },
      "429": {
       "type": "application/json",
       "schema": "error.schema.json"
      },
      "503": {
       "type": "application/json",
       "schema": "error.schema.json"
      }
     }
    },
    "OPTIONS": {
     "answers": {
      "204": {
       "note": "a preflight: access-control-allow-methods POST, OPTIONS; allow-headers content-type; max-age 600"
      }
     }
    },
    "*": {
     "answers": {
      "405": {
       "type": "application/json",
       "schema": "error.schema.json"
      }
     }
    }
   }
  },
  {
   "path": "/trial",
